{
  "name": "whosees",
  "productName": "WhoSees",
  "version": "0.1.0",
  "description": "See where your computer's data is going, live on a map.",
  "license": "GPL-3.0-or-later",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:linux": "cd ../agent && ~/.cargo/bin/cargo build --release && cd ../app && electron-builder --linux AppImage rpm",
    "dist:win": "cd ../agent && cargo build --release && cd ../app && electron-builder --win nsis"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@protomaps/basemaps": "^5.7.2",
    "maplibre-gl": "^6.18.0",
    "pmtiles": "^4.5.0"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "homepage": "https://github.com/techytj/whosees",
  "author": {
    "name": "TechyTJ",
    "email": "31286782+techytj@users.noreply.github.com"
  },
  "build": {
    "appId": "io.github.techytj.whosees",
    "productName": "WhoSees",
    "copyright": "GPL-3.0-or-later",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "renderer/**",
      "build/icon.png",
      "node_modules/maplibre-gl/dist/**",
      "node_modules/pmtiles/dist/**",
      "node_modules/fflate/esm/**",
      "node_modules/@protomaps/basemaps/dist/**",
      "node_modules/maplibre-gl/LICENSE.txt",
      "node_modules/fflate/LICENSE"
    ],
    "extraResources": [
      {
        "from": "../../shared/geo/world.wtgeo",
        "to": "shared/geo/world.wtgeo"
      },
      {
        "from": "../../shared/map",
        "to": "shared/map",
        "filter": [
          "world-z6.pmtiles",
          "fonts/**"
        ]
      },
      {
        "from": "../../shared/categories/domains.json",
        "to": "shared/categories/domains.json"
      },
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../../shared/threats",
        "to": "shared/threats",
        "filter": [
          "domains.txt",
          "ips.txt"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "rpm"
      ],
      "category": "Network",
      "icon": "build/icon.png",
      "executableName": "whosees",
      "synopsis": "See where your data is going, live on a map",
      "extraResources": [
        {
          "from": "../agent/target/release/whosees-agent",
          "to": "agent/whosees-agent"
        }
      ],
      "maintainer": "TechyTJ <31286782+techytj@users.noreply.github.com>"
    },
    "rpm": {
      "depends": [
        "polkit",
        "nftables",
        "iproute"
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "../agent/target/release/whosees-agent.exe",
          "to": "agent/whosees-agent.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "WhoSees"
    }
  }
}
