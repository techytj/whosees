<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>WhoSees</vendor>
  <vendor_url>https://github.com/techytj/whosees</vendor_url>
  <icon_name>whosees</icon_name>
  <action id="io.github.techytj.whosees.deep">
    <description>Turn on WhoSees Deep mode</description>
    <message>WhoSees needs your login password to turn on Deep mode: reading where network packets are going (never their contents) to show website names and trackers, and adding firewall rules for anything you block. Access ends when you press Stop.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/opt/WhoSees/resources/agent/whosees-agent</annotate>
  </action>
</policyconfig>
