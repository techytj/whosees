# Copy to tools/local.env (never committed) and fill in your own machines.
VM=user@windows-test-vm              # Windows VM for tests/windows and the installer build (SSH, key auth)
WT_MINGW='C:\path\to\WinLibs\mingw64\bin'   # WinLibs dlltool inside that VM
WT_SITE_HOST=user@web-server         # where tools/site-deploy.sh publishes the website
